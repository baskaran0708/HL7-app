<?xml version="1.0" encoding="utf-8"?><!--
  Launcher icon foreground — a double helix.

  Chosen because it reads instantly as clinical/scientific at launcher size, ties to the product's
  internal name (Helix), and survives being shrunk: two strands and three rungs is about as much
  detail as a 48dp icon can carry before it turns to mush.

  Geometry sits inside the 72x72 adaptive-icon safe zone (x/y 18..90), so no launcher mask —
  circle, squircle or rounded square — can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:alpha="0.70">
        <path android:pathData="M36,30 L72,30" android:strokeColor="#FFFFFFFF" android:strokeWidth="6" android:strokeLineCap="round" />
        <path android:pathData="M36,54 L72,54" android:strokeColor="#FFFFFFFF" android:strokeWidth="6" android:strokeLineCap="round" />
        <path android:pathData="M36,78 L72,78" android:strokeColor="#FFFFFFFF" android:strokeWidth="6" android:strokeLineCap="round" />
    </group>

    <path android:pathData="M36,30 C36,43 72,43 72,54 C72,65 36,65 36,78" android:strokeColor="#FFFFFFFF" android:strokeWidth="8.5" android:strokeLineCap="round" />
    <path android:pathData="M72,30 C72,43 36,43 36,54 C36,65 72,65 72,78" android:strokeColor="#FFFFFFFF" android:strokeWidth="8.5" android:strokeLineCap="round" />
</vector>
