<?xml version="1.0" encoding="utf-8"?><!--
  Launcher icon background.

  A diagonal ramp through the brand violet (HelixPalette.VIOLET: primaryLift → primary →
  a deepened primaryDim), so the icon reads as the same product as the app's UI rather than
  as a generic tile. Darkening toward the bottom-right keeps the white helix legible at
  launcher size and gives the icon depth against both light and dark wallpapers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6"
                android:startY="0"
                android:endX="102"
                android:endY="108">
                <item
                    android:offset="0"
                    android:color="#FFA78BFA" />
                <item
                    android:offset="0.45"
                    android:color="#FF8B5CF6" />
                <item
                    android:offset="1"
                    android:color="#FF4C1D95" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft highlight in the top-left so the tile isn't a flat wash. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="32"
                android:centerY="26"
                android:gradientRadius="74">
                <item
                    android:offset="0"
                    android:color="#33FFFFFF" />
                <item
                    android:offset="1"
                    android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
